# Java compiled files
*.class
# Ignore compiled libraries except the MySQL Connector/J in lib
*.jar
!lib/*.jar*
.war
*.ear
out/
target/
build/

# IntelliJ IDEA
.idea/
*.iml

# Other Java IDEs
.eclipse/
.settings/
.project
.classpath

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.swp
*~

# Environment variables and credentials
.env
.env.*
!.env.example

# Local database connection settings
db-credentials.properties
application-local.properties

# Local exports and generated database files
*.dump
*.bak.sql